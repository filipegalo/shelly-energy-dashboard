FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/mock-shelly ./cmd/mock-shelly
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/mock-shelly ./cmd/mock-shelly
FROM scratch
COPY --from=build /out/mock-shelly /mock-shelly
EXPOSE 80
ENTRYPOINT ["/mock-shelly"]
